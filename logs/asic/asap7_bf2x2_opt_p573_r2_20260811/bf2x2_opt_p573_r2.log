@file(genus_asap7_v2.tcl) 26: set vhd [glob -nocomplain $RTL_DIR/*.vhd]
@file(genus_asap7_v2.tcl) 27: if {[llength $vhd] > 0} {
  set pkgs {}
  set rest {}
  foreach f $vhd {
    if {[string match "*sha3_pkg.vhd" $f] || [string match "*keccak_pkg.vhd" $f]} {
      lappend pkgs $f
    } else {
      lappend rest $f
    }
  }
  read_hdl -language vhdl [list $RTL_DIR/sha3_pkg.vhd $RTL_DIR/keccak_pkg.vhd]
  read_hdl -language vhdl [lsort $rest]
}
