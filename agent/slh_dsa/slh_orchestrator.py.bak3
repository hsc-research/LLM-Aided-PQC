#!/usr/bin/env python3
"""SLH-DSA block orchestrator: the rule-book transfer test.

HQC produced core wins. ML-DSA turned those wins into a written POLICY.
SLH-DSA is the first design where the rule book exists BEFORE any work on
the design. The POLICY below is copied VERBATIM from
agent/mldsa/orchestrator.py, including the ML-DSA-specific FORBIDDEN
entries (coeff_decomposer, unpipelined DSP). It is deliberately NOT tuned
for SLH-DSA: a rule that fails to fire must fail on its own stated
conditions, not because the menu was rewritten to fit a new design.

Differences from the ML-DSA orchestrator, and why:
  - No block-level synthesis. SLH-DSA is judged at chip closure only
    (composition null result: block wins did not compose on ML-DSA).
    This script edits and gates; chip_orchestrator.py re-judges.
  - Timing path comes from the chip log, not a per-block OOC run.
  - Gate is whole-design sign-and-verify plus a golden signature diff.

Usage:
  python3 agent/slh_dsa/slh_orchestrator.py <block> [--dry]
    block: basename of the dispatched file, e.g. sha256_core
    --dry: call the model and log the verdict, apply nothing
"""
import sys, os, re, json, shutil, time, subprocess

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", ".."))
sys.path.insert(0, os.path.join(REPO, "agent"))
os.chdir(REPO)

import anthropic
from learned_rules import rules_prompt_block

MODEL     = "claude-sonnet-4-6"
LOG       = os.path.join(HERE, "slh_orchestrator_log.jsonl")
CHIP_LOG  = os.path.join(REPO, "agent", "chip_orchestrator_log.jsonl")
SRC_ROOT  = os.path.join(REPO, "agent", "slh_dsa", "slh_src")
PRISTINE  = os.path.join(REPO, "agent", "slh_dsa", "pristine")

# Files the agent is allowed to edit, keyed by basename. Anything the chip
# loop maps to that is not listed here is out of scope and the run stops.
BLOCKS = {
    "sha256_core":   "agent/slh_dsa/slh_src/sphincslet/sha/sha256_core.v",
    "sha256_w_mem":  "agent/slh_dsa/slh_src/sphincslet/sha/sha256_w_mem.v",
    "sha512_core":   "agent/slh_dsa/slh_src/sphincslet/sha/sha512_core.v",
    "sha512_w_mem":  "agent/slh_dsa/slh_src/sphincslet/sha/sha512_w_mem.v",
    "sha512_core":   "agent/slh_dsa/slh_src/sphincslet/sha/sha512_core.v",
    "sha512_w_mem":  "agent/slh_dsa/slh_src/sphincslet/sha/sha512_w_mem.v",
    "hash_tile":     "agent/slh_dsa/slh_src/sphincslet/hash_tile/hash_tile.v",
    "FSM":           "agent/slh_dsa/slh_src/sphincslet/fsm/FSM.v",
    "WOTS_FSM":      "agent/slh_dsa/slh_src/sphincslet/fsm/WOTS_FSM.v",
    "XMSS_FSM":      "agent/slh_dsa/slh_src/sphincslet/fsm/XMSS_FSM.v",
}

# ---------------------------------------------------------------------------
# POLICY: verbatim from agent/mldsa/orchestrator.py. DO NOT EDIT for SLH-DSA.
# ---------------------------------------------------------------------------
POLICY = """VALIDATED STRATEGY MENU (pick exactly one, or no_action):
1. flag_precompute: compare logic on already-registered inputs feeding CE/write-index
   decode -> register the flag from pre-register inputs. (n=5, best pattern.)
   SOURCE RULE (validated): the precomputed expression's source must be a value
   with a PARALLEL registered copy (shadow/mirror computable one cycle early);
   NEVER a self-loop endpoint (e.g. ctr_next feeding ctr) — the loop endpoint IS
   the critical dependency and cannot be precomputed (usehint negative).
2. constant_lut: small-domain arithmetic chain -> constant LUT. (n=1 win, 1 loss)
   HARD DOMAIN CAP: input domain must be <=8 bits AND proven to be the BINDING
   mode of its cone. In mode-shared transform cones, attribute the binding mode
   first; a bit-exact LUT of a non-binding mode disturbs cross-mode sharing and
   regresses (decoder S-LUT negative, -0.283ns).
3. sign_select: applies ONLY when pristine computes the correction via a
   sign-extract/mask idiom (>>31 & Q style) -> rewrite to explicit compare or
   single subtract+select. (n=2 wins on sign-extract forms.) EXCLUSION
   (validated n=2, widths 13-24b): if pristine is ALREADY a ternary on an
   explicit compare ((x > C) ? a : b), both arms synthesize in parallel;
   rewriting to subtract-then-sign-select SERIALIZES and regresses. Never
   propose sign_select on an existing explicit-compare ternary.
4. shifter_mux_reduce: variable shifter ONLY if the reachable shift-amount set is
   already proven closed in findings AND the shift amount reaches the shifter as an
   opaque COMPUTED value (arithmetic like len-amt). If the amount signal is assigned
   only literal constants, Vivado already infers the select — the rewrite is DEAD
   (bit-identical netlist, verified on rejection_y input shift). NEVER propose new
   probes; if unproven or literal-assigned, no_action with reason "shifter unproven"
   or "shifter amount literal-assigned".
5. max_fanout_16: route-bound (route% >= ~70) + high-fanout source register ->
   (* max_fanout = 16 *) on the SOURCE REGISTER declaration. Never on combinational
   always@(*) regs (regressed twice). LOAD-PROFILE RULE (validated, n=4 wins/2 losses):
   pays on NARROW regs (FSM state, counters, small flags) whose loads are a
   HOMOGENEOUS wide bank (CE decode arrays, register-file enables); LOSES on wide
   regs (SIPO buses) and on regs with heterogeneous load types. Default N=16;
   N=8 optimal on very small regs (makehint num_hints); sweep only if 16 is
   marginal.
FORBIDDEN (never propose): arithmetic-divide rewrites, unpipelined DSP inference,
ANY latency/cycle-schedule change (lockstep gate will fail), width-narrowing on
placement-sensitive paths, sensitivity-list-only edits, edits to coeff_decomposer,
edits targeting a path through an unpipelined DSP multiply (DSP-latency-bound:
~4ns intrinsic, only fixable by MREG/PREG = latency change; butterfly closed on this).
OUTPUT: JSON only, one of:
{"verdict":"experiment","strategy":"<menu name>","reason":"<1 sentence>",
 "edits":[{"old":"<exact unique substring>","new":"<replacement>"}, ...]}
{"verdict":"no_action","reason":"<1 sentence>"}
1 to 4 edit pairs. Each "old" MUST occur exactly once in the file, byte-exact
including whitespace. Edits are applied in order, all-or-nothing.
For flag_precompute you typically need: (a) declare the flag reg at module
scope, (b) assign the flag at EVERY update site of the source register,
computed from the SAME pre-register expressions, (c) swap the consumer
compare to the flag. A flag nobody consumes is dead logic and changes nothing.
The edit must be latency-neutral: same outputs on the same cycles."""


def log(rec):
    rec["ts"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    with open(LOG, "a") as f:
        f.write(json.dumps(rec) + "\n")
    print("LOG:", rec.get("verdict"), rec.get("reason", ""))


def chip_context():
    """Most recent SLH-DSA chip closure record: path, slack, closure."""
    if not os.path.exists(CHIP_LOG):
        return None
    recs = [json.loads(l) for l in open(CHIP_LOG) if l.strip()]
    recs = [r for r in recs if r.get("design") == "slh_dsa"]
    return recs[-1] if recs else None


def path_detail(tag, period):
    """Pull logic/route split and levels from the closing report."""
    rpt = f"/tmp/fsrch_{tag}_{period}.rpt"
    if not os.path.exists(rpt):
        return {}
    txt = open(rpt).read()
    d = {}
    m = re.search(r"Data Path Delay:\s+([\d.]+)ns\s+\(logic ([\d.]+)ns \(([\d.]+)%\)\s+route ([\d.]+)ns \(([\d.]+)%\)\)", txt)
    if m:
        d.update(delay_ns=float(m.group(1)), logic_pct=float(m.group(3)),
                 route_pct=float(m.group(5)))
    m = re.search(r"Logic Levels:\s+(\d+)\s+\(([^)]*)\)", txt)
    if m:
        d.update(levels=int(m.group(1)), cells=m.group(2).strip())
    return d


def classify(detail):
    """Deterministic tags. Same thresholds as the ML-DSA classifier so the
    model sees the same decision surface it was tuned against."""
    tags = []
    if not detail:
        return ["no path detail available"]
    if detail.get("route_pct", 0) >= 70: tags.append("route-heavy")
    if detail.get("logic_pct", 0) >= 40: tags.append("logic-heavy")
    if detail.get("levels", 0) >= 12:    tags.append(f"deep({detail['levels']}lv)")
    out = [f"path[{detail.get('delay_ns')}ns]: {','.join(tags) or 'mixed'} "
           f"cells={detail.get('cells')}"]
    if detail.get("route_pct", 0) < 70:
        out.append("NOTE: route% is below the ~70 threshold, so the max_fanout_16 "
                   "route-bound precondition is NOT met.")
    if "CARRY4" in (detail.get("cells") or ""):
        out.append("NOTE: the path contains a CARRY4 carry chain.")
    return out


def call_llm(block, rtl, ctx, tags, extra=""):
    client = anthropic.Anthropic()
    prompt = (f"BLOCK: {block} (SLH-DSA / SPHINCSLET, Artix-7 xc7a200tfbg676-1, "
              f"whole-design OOC, judged at chip closure).\n"
              f"CODE-COMPUTED CLASSIFICATION (authoritative): {tags}\n\n"
              f"CHIP CLOSURE: {json.dumps(ctx.get('closure'))}\n"
              f"BINDING PATH: {json.dumps(ctx.get('worst_path'))}\n\n"
              f"FULL RTL:\n{rtl}\n\n"
              + ("NOTE: the binding path above is NOT inside this file. You are "
                 "being asked whether any menu strategy has purchase on THIS "
                 "module's own structure, not whether it fixes the chip binding "
                 "path. Any edit here is speculative with respect to closure.\n\n"
                 if block not in (ctx.get("dispatch_instance") or "").lower()
                    and block.lower() not in (ctx.get("dispatch_file") or "").lower()
                 else "")
              + "Fill exactly two slots: strategy + str-replace pair. JSON only. "
                "If no menu entry's stated preconditions are met, answer no_action.")
    usage = {}
    for attempt in range(2):
        r = client.messages.create(model=MODEL, max_tokens=2000,
            system=POLICY + rules_prompt_block("slh_dsa") + extra,
            messages=[{"role": "user", "content": prompt}])
        usage = {"in": r.usage.input_tokens, "out": r.usage.output_tokens}
        txt = r.content[0].text
        i, j = txt.find("{"), txt.rfind("}")
        if i != -1 and j > i:
            try:
                return json.loads(txt[i:j+1]), usage
            except json.JSONDecodeError as e:
                err = str(e)
        else:
            err = "no JSON object found"
        print(f"RAW MODEL OUTPUT (attempt {attempt+1}):\n{txt[:800]}")
        prompt += (f"\n\nYOUR PREVIOUS REPLY WAS NOT VALID JSON ({err}). Reply "
                   "with ONLY the JSON object, no prose, no code fences.")
    raise SystemExit("LLM failed to produce valid JSON twice; aborting.")


RULES = os.path.join(REPO, "agent", "learned_rules.jsonl")


def put_rule(rec):
    with open(RULES, "a") as f:
        f.write(json.dumps(rec) + "\n")
    return rec


def proposed_rules(design="slh_dsa"):
    """Candidate rules not yet refuted, newest last."""
    if not os.path.exists(RULES):
        return []
    recs = [json.loads(l) for l in open(RULES) if l.strip()]
    out = {}
    for r in recs:
        if r.get("design") in (design, "all"):
            out[r["rule_id"]] = r          # later records supersede earlier
    return [r for r in out.values() if r.get("status") != "refuted"]


def propose_rule(block, rtl, ctx, tags, decline_reason):
    """One call: given that no menu entry applied, what rule would have?"""
    client = anthropic.Anthropic()
    prompt = (
        "You maintain an optimization rulebook for FPGA PPA agents. The "
        "existing menu returned no_action on this cone for this reason:\n"
        f"{decline_reason}\n\n"
        f"CLASSIFICATION: {tags}\n"
        f"BINDING PATH: {json.dumps(ctx.get('worst_path'))}\n\n"
        f"RTL:\n{rtl}\n\n"
        "Propose EXACTLY ONE new candidate strategy that WOULD address this "
        "structure, in the same form as the existing menu entries. It must be "
        "latency-neutral (no added or removed cycles), must not change the "
        "module interface, and must be a standard, well-understood hardware "
        "transformation rather than a speculative one. State the PRECONDITIONS "
        "under which it applies, not just the transformation. If no sound "
        "latency-neutral transformation exists for this structure, say so.\n\n"
        'JSON only: {"rule_id":"<short_snake_name>","rule":"<<=60 words, '
        'conditions first>","applies_when":"<precondition test>",'
        '"expected_effect":"<what should improve>"} '
        'or {"rule_id":null,"reason":"<why nothing applies>"}')
    r = client.messages.create(model=MODEL, max_tokens=600,
                               messages=[{"role": "user", "content": prompt}])
    txt = r.content[0].text
    i, j = txt.find("{"), txt.rfind("}")
    if i == -1 or j <= i:
        return None
    try:
        d = json.loads(txt[i:j+1])
    except json.JSONDecodeError:
        return None
    if not d.get("rule_id"):
        print("no candidate rule proposed:", d.get("reason", ""))
        return None
    return put_rule({
        "ts": time.strftime("%F %T"), "design": "slh_dsa",
        "rule_id": d["rule_id"], "rule": d["rule"],
        "applies_when": d.get("applies_when"),
        "expected_effect": d.get("expected_effect"),
        "status": "proposed",
        "evidence": {"block": block, "cone": ctx.get("dispatch_instance"),
                     "closure": ctx.get("closure"),
                     "declined_by_menu": decline_reason},
        "source_model": MODEL,
        "usage": {"in": r.usage.input_tokens, "out": r.usage.output_tokens},
    })


def resolve_rule(rule_id, status, note, closure_after=None):
    """Record the outcome of a candidate. Both directions get written:
    a refuted rule stays in the file with status=refuted and the reason."""
    return put_rule({"ts": time.strftime("%F %T"), "design": "slh_dsa",
                     "rule_id": rule_id, "rule": "(resolution record)",
                     "status": status, "note": note,
                     "closure_after": closure_after})


def apply_edits(src, edits):
    """Anchor-count assert on every edit, all-or-nothing, .bak first."""
    s = open(src).read()
    for e in edits:
        n = s.count(e["old"])
        if n != 1:
            return False, f"anchor count {n} for: {e['old'][:60]!r}"
    shutil.copy(src, src + ".bak")
    for e in edits:
        s = s.replace(e["old"], e["new"], 1)
    open(src, "w").write(s)
    return True, "applied"


CFGS = ["128s", "128f", "192s", "192f", "256s", "256f"]
# SHA-512 is instantiated only at 192 and 256. setting.v defines HASH2 =
# "SHA512" for PARAM_192 and PARAM_256 and leaves it undefined at PARAM_128,
# so a gate run at 128 would never elaborate sha512_core and would pass on
# unedited code.
NEEDS_SHA512 = ("sha512_core", "sha512_w_mem")
SHA512_CFGS = ("192s", "192f", "256s", "256f")


def set_cfg(rtl_dir, cfg):
    """Rewrite setting.v in place so exactly one parameter set is enabled."""
    p = os.path.join(rtl_dir, "sphincslet", "setting.v")
    s = open(p).read()
    for c in CFGS:
        tok = "`define PARAM_" + c.upper()
        s = s.replace("//" + tok + "\n", tok + "\n").replace(tok + "\n", "//" + tok + "\n")
    tok = "`define PARAM_" + cfg.upper()
    assert s.count("//" + tok + "\n") == 1, f"{cfg}: expected one commented {tok}"
    s = s.replace("//" + tok + "\n", tok + "\n")
    enabled = [c for c in CFGS if re.search(r"^`define PARAM_" + c.upper() + r"$", s, re.M)]
    assert enabled == [cfg], f"{cfg}: enabled set is {enabled}"
    open(p, "w").write(s)
    return p


def gate_at(cfg):
    """Run the vendor testbench at cfg and diff against that cfg's golden,
    which level_sweep.py froze from the pristine arm."""
    gold = os.path.join(REPO, "agent/slh_dsa/gate/levels", f"SIG_{cfg}.hex")
    if not os.path.exists(gold):
        return {"status": "ERROR", "reason": f"no golden for {cfg}; run level_sweep first"}
    data = "/mnt/c/PQC/slh_sim/TECS_v8.srcs/sources_1/imports/data_sha2"
    produced = os.path.join(data, f"SIG_file0_{cfg}_w.hex")
    if os.path.exists(produced):
        os.remove(produced)
    simd = "/mnt/c/PQC/slh_sim/a/b/c/d"
    env = dict(os.environ, SLH_RTL=SRC_ROOT)
    r = subprocess.run(["bash", os.path.join(simd, "run_sim.sh")], cwd=simd,
                       env=env, capture_output=True, text=True, timeout=7200)
    if "xvlog errors: 0" not in r.stdout or "xelab errors: 0" not in r.stdout:
        return {"status": "ERROR", "reason": "compile or elaboration errors"}
    if not os.path.exists(produced):
        return {"status": "FAIL", "reason": "no signature produced"}
    if open(gold, "rb").read() != open(produced, "rb").read():
        return {"status": "FAIL", "reason": "signature differs from golden"}
    if "The signature is matched" not in r.stdout:
        return {"status": "FAIL", "reason": "verify did not report match"}
    return {"status": "PASS", "reason": f"signature matches {cfg} golden"}


def main():
    block = sys.argv[1] if len(sys.argv) > 1 else None
    dry   = "--dry" in sys.argv
    cfg = None
    if "--cfg" in sys.argv:
        i = sys.argv.index("--cfg")
        if i + 1 < len(sys.argv):
            cfg = sys.argv[i + 1]
    if cfg is not None and cfg not in CFGS:
        print(f"--cfg must be one of {CFGS}")
        sys.exit(1)
    if block in NEEDS_SHA512 and cfg not in SHA512_CFGS:
        print(f"{block} requires --cfg from {SHA512_CFGS}. SHA-512 is not "
              "instantiated at 128, so a 128 gate would pass without "
              "elaborating the edited core.")
        sys.exit(1)
    if block not in BLOCKS:
        print(f"block {block!r} not in scope. In scope: {sorted(BLOCKS)}")
        sys.exit(1)
    src = BLOCKS[block]

    ctx = chip_context()
    if not ctx:
        log({"block": block, "verdict": "abort",
             "reason": "no SLH-DSA chip closure record; run chip_orchestrator first"})
        sys.exit(1)

    if cfg:
        set_cfg(SRC_ROOT, cfg)
        print(f"tracked tree set to {cfg}")

    # Pre-edit gate self-check: never edit a tree that is already failing.
    if cfg:
        g = gate_at(cfg)
        ok = g["status"] == "PASS"
        detail = g["reason"]
    else:
        r = subprocess.run(["python3", "agent/slh_dsa/slh_kat_gate.py"],
                           capture_output=True, text=True, timeout=7200)
        ok, detail = r.returncode == 0, r.stdout.strip()[-200:]
    if not ok:
        log({"block": block, "cfg": cfg, "verdict": "abort",
             "reason": "pre-edit gate self-check FAIL: " + detail})
        sys.exit(1)
    print("Pre-edit gate self-check: PASS")

    detail = path_detail(ctx["closure"]["tag"], ctx["closure"]["closing_period_ns"])
    tags = classify(detail)
    print(f"classification: {tags}")

    rtl = open(src).read()
    extra = ""
    if "--use-proposed" in sys.argv:
        cands = proposed_rules()
        if cands:
            extra = ("\n\nUNVALIDATED CANDIDATE RULES. These are UNTESTED "
                     "HYPOTHESES with zero supporting measurements. They are "
                     "NOT validated, NOT evidence-backed, and may well be "
                     "wrong. Never describe them as validated. The menu above "
                     "wins on conflict. If you use one, name its rule_id in "
                     "\"strategy\" and state in \"reason\" that it is "
                     "untested:\n" +
                     "\n".join(f"- [{c['rule_id']}] {c['rule']}\n"
                                f"  applies_when: {c.get('applies_when')}"
                                for c in cands))
            print(f"injecting {len(cands)} candidate rule(s)")
    verdict, usage = call_llm(block, rtl, ctx, tags, extra)
    rec = {"block": block, "design": "slh_dsa", "src": src, "cfg": cfg,
           "closure_before": ctx["closure"], "path_detail": detail,
           "tags": tags, "usage": usage, "model": MODEL}
    rec.update(verdict)

    if verdict.get("verdict") != "experiment":
        log(rec)
        print("no_action: rule book offered no strategy for this cone.")
        # The menu had nothing. Ask what rule WOULD have applied, and record
        # it as a candidate. Candidates are proposals, not results: they carry
        # status=proposed until a gate and a closure verdict resolve them.
        prop = propose_rule(block, rtl, ctx, tags, verdict.get("reason", ""))
        if prop:
            print(f"CANDIDATE RULE: {prop['rule']}")
        return
    if dry:
        rec["verdict"] = "dry_run"
        log(rec)
        return

    ok, why = apply_edits(src, verdict.get("edits", []))
    if not ok:
        rec["verdict"] = "anchor_fail"; rec["reason"] = why
        log(rec); sys.exit(1)
    print(f"edits applied to {src} (.bak written)")

    if cfg:
        gg = gate_at(cfg)
        print(f"gate: {gg['status']} ({gg['reason']})")
        class _R: pass
        g = _R(); g.returncode = 0 if gg["status"] == "PASS" else 1
        g.stdout = gg["reason"]
    else:
        g = subprocess.run(["python3", "agent/slh_dsa/slh_kat_gate.py"],
                           capture_output=True, text=True, timeout=7200)
        print(g.stdout.strip()[-300:])
    if g.returncode != 0:
        shutil.copy(src + ".bak", src)
        rec["verdict"] = "gate_fail"
        rec["reason"] = g.stdout.strip()[-200:]
        log(rec)
        print("GATE FAIL: reverted from .bak")
        sys.exit(1)

    rec["verdict"] = "ACCEPTED_PENDING_CLOSURE"
    rec["reason"] = ("gate PASS; edit is functionally neutral. Closing fmax not "
                     "yet re-judged: re-run chip_orchestrator.py slh_dsa and "
                     "accept only if closure improves.")
    log(rec)
    print("ACCEPTED (gate). Re-run chip_orchestrator.py slh_dsa to judge closure.")


if __name__ == "__main__":
    main()
